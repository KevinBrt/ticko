# Ticko configuration. Copy to .env next to docker-compose.yml and adjust.
#
# TICKO_* variables are read by Ticko itself. Unknown TICKO_* variables stop the server at
# startup, to catch typos. Any of them can be read from a file by appending _FILE
# (Docker secrets), e.g. TICKO_DATABASE_URL_FILE=/run/secrets/ticko_database_url

# --- docker-compose.yml only ----------------------------------------------------------------

# Required. Password of the bundled PostgreSQL. Use hex so it is safe inside a URL:
#   openssl rand -hex 32
POSTGRES_PASSWORD=

# Image tag to run. Pin a version (e.g. 0.1.0) in production; "latest" follows releases.
IMAGE_TAG=latest

# Port published on the host.
HTTP_PORT=3000

# --- Ticko ----------------------------------------------------------------------------------

# Public URL users open, without path. Use https:// behind a TLS reverse proxy:
# it enables HSTS and upgrades insecure requests.
TICKO_URL=http://localhost:3000

# PostgreSQL 16+ connection string. docker-compose.yml sets it for the bundled database;
# set it yourself when using an external server.
# TICKO_DATABASE_URL=postgres://ticko:password@db.example.com:5432/ticko?sslmode=require

# Trust X-Forwarded-* headers. Enable only when Ticko is reachable solely through your proxy.
TICKO_TRUST_PROXY=false

# fatal, error, warn, info, debug, trace or silent.
TICKO_LOG_LEVEL=info

# Interface and port Ticko listens on inside the container. Rarely needs changing.
# TICKO_HOST=0.0.0.0
# TICKO_PORT=3000
