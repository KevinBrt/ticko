#!/bin/sh
# Commit messages follow Conventional Commits: they drive versions and the changelog.
pattern='^(feat|fix|perf|refactor|docs|test|build|ci|chore|revert)(\([a-z0-9-]+\))?!?: [^ ].*'
first_line=$(head -n 1 "$1")
case "$first_line" in
  Merge*|Revert*|fixup!*|squash!*) exit 0 ;;
esac
if ! printf '%s' "$first_line" | grep -Eq "$pattern"; then
  echo "Commit message must follow Conventional Commits, e.g. 'feat(issues): add labels'." >&2
  echo "Got: $first_line" >&2
  exit 1
fi
